-- Проверка
SELECT
    e.title AS "Мероприятие",
    e.date_time AS "Дата проведения",
    s.full_name AS "ФИО Студента",
    s.group_name AS "Группа",
    ep.registered_at AS "Дата записи"
FROM event_participations ep
JOIN events e ON ep.event_id = e.id
JOIN students s ON ep.student_id = s.id
ORDER BY e.date_time, s.full_name;


